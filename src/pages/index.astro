---
import CaseSection from '../components/home/CaseSection.astro';
import EducationSection from '../components/home/EducationSection.astro';
import EmbodiedSection from '../components/home/EmbodiedSection.astro';
import FactorySection from '../components/home/FactorySection.astro';
import HomeHero from '../components/home/HomeHero.astro';
import MobileCapabilityOverview from '../components/home/MobileCapabilityOverview.astro';
import MobileDeliverySection from '../components/home/MobileDeliverySection.astro';
import MobileProjectSection from '../components/home/MobileProjectSection.astro';
import MobileScenarioSection from '../components/home/MobileScenarioSection.astro';
import ProjectCta from '../components/home/ProjectCta.astro';
import PartnerMarquee from '../components/home/PartnerMarquee.astro';
import SolutionSplit from '../components/home/SolutionSplit.astro';
import TechnologySection from '../components/home/TechnologySection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveImage } from '../lib/images';
---

<BaseLayout
  title="天津光泰科技集团 | AI应用工厂、具身智能与数智化建设"
  description="天津光泰科技集团成立于2013年，总部位于天津，服务京津冀并辐射全国，提供软件开发、系统集成、AI应用工厂、具身智能、智能空间和持续运营服务。"
  ogImage={resolveImage('/assets/hero-humanoid-ai-campus.png').src}
>
  <main>
    <HomeHero /><MobileCapabilityOverview /><MobileDeliverySection
    /><MobileScenarioSection /><MobileProjectSection /><FactorySection
    /><EmbodiedSection /><PartnerMarquee /><SolutionSplit /><EducationSection
    /><TechnologySection /><CaseSection /><ProjectCta />
  </main>
</BaseLayout>
