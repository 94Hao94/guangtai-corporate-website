---
import { projectTypes } from '../../data/home';
import HomeChapter from './HomeChapter.astro';
---

<section class="cases section-pad">
  <HomeChapter number="04" title="项目实践" english="PROJECT PRACTICE" />
  <div class="section-heading" data-reveal>
    <p class="eyebrow">PROJECT PRACTICE</p><h2>以客户真实建设需求为起点</h2><p>
      官网不虚构数量与客户名称。以下作为可替换的项目实践类型，待真实案例材料确认后更新。
    </p>
  </div><div class="case-row">
    {
      projectTypes.map(([title, text], index) => (
        <article data-reveal>
          <>
            <span>PROJECT TYPE / 0{index + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </>
        </article>
      ))
    }
  </div>
</section>
