---
import { partners } from '../../data/partners';
import { projectTypes } from '../../data/home';
---

<section
  class="mobile-projects"
  data-mobile-projects
  aria-labelledby="mobile-projects-title"
>
  <p class="mobile-section-kicker">PROJECT PRACTICE</p>
  <h2 id="mobile-projects-title">从真实建设需求出发</h2>
  <ol class="mobile-project-list">
    {
      projectTypes.map(([title, copy], index) => (
        <li>
          <span>0{index + 1}</span>
          <div>
            <h3>{title}</h3>
            <p>{copy}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <div
    class="mobile-partners"
    data-mobile-partners
    aria-labelledby="mobile-partners-title"
  >
    <p>EMBODIED ECOSYSTEM</p>
    <h3 id="mobile-partners-title">合作伙伴</h3>
    <div class="mobile-partner-viewport">
      <div class="mobile-partner-track">
        {
          partners.map((partner) => (
            <a
              href={partner.href}
              target="_blank"
              rel="noreferrer"
              data-partner-logo-surface={partner.logoSurface}
            >
              <img
                src={partner.logo}
                alt={partner.logoAlt}
                loading="lazy"
                decoding="async"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
