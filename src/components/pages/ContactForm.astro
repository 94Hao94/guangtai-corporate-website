<section
  id="capabilities"
  class="contact-form-section inner-section"
  data-reveal
>
  <div class="inner-heading">
    <p>PROJECT CONTACT</p><h2>留下项目需求，我们从真实场景开始沟通</h2>
  </div><form class="project-contact-form" data-project-contact-form novalidate>
    <label>
      <span>姓名</span>
      <input
        id="name"
        name="name"
        required
        autocomplete="name"
        aria-describedby="name-error"
      />
      <small id="name-error" data-field-error="name"></small>
    </label>
    <label>
      <span>单位</span>
      <input
        id="organization"
        name="organization"
        required
        autocomplete="organization"
        aria-describedby="organization-error"
      />
      <small id="organization-error" data-field-error="organization"></small>
    </label>
    <label class="contact-form-contact">
      <span>联系方式</span>
      <input
        id="contact"
        name="contact"
        required
        autocomplete="tel"
        aria-describedby="contact-error"
      />
      <small id="contact-error" data-field-error="contact"></small>
    </label>
    <label>
      <span>项目类型</span>
      <select
        id="projectType"
        name="projectType"
        required
        aria-describedby="project-type-error"
      >
        <option value="">请选择项目类型</option>
        <option>AI应用与智能体</option>
        <option>具身智能</option>
        <option>系统集成</option>
        <option>其他项目</option>
      </select>
      <small id="project-type-error" data-field-error="projectType"></small>
    </label>
    <label>
      <span>计划时间</span>
      <select
        id="timeline"
        name="timeline"
        required
        aria-describedby="timeline-error"
      >
        <option value="">请选择计划时间</option>
        <option>1个月内</option>
        <option>1-3个月</option>
        <option>3-6个月</option>
        <option>待评估</option>
      </select>
      <small id="timeline-error" data-field-error="timeline"></small>
    </label>
    <label class="contact-form-message">
      <span>需求描述</span>
      <textarea
        id="message"
        name="message"
        required
        minlength="10"
        aria-describedby="message-error"></textarea>
      <small id="message-error" data-field-error="message"></small>
    </label>
    <div class="contact-form-action">
      <button type="submit"
        >提交项目需求 <span aria-hidden="true">↗</span></button
      ><p role="status" aria-live="polite" data-contact-status>
        联系渠道尚未配置，提交后将提示当前状态。
      </p>
    </div>
  </form>
</section>

<script>
  type ContactControl =
    HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  const requiredMessages: Record<string, string> = {
    name: '请输入姓名',
    organization: '请输入单位',
    contact: '请输入联系方式',
    projectType: '请选择项目类型',
    timeline: '请选择计划时间',
    message: '请至少输入 10 个字的需求描述',
  };

  /**
   * Adds browser validation and a truthful delivery status to one project contact form.
   * @param form The form element to initialize.
   * @returns Nothing.
   */
  const initializeContactForm = (form: HTMLFormElement): void => {
    if (form.dataset.contactFormInitialized) return;
    form.dataset.contactFormInitialized = 'true';
    const status = form.querySelector<HTMLElement>('[data-contact-status]');
    const controls = Array.from(
      form.querySelectorAll<ContactControl>(
        'input[required], select[required], textarea[required]',
      ),
    );

    /**
     * Validates one required form control and updates its associated error message.
     * @param control The input, select, or textarea to validate.
     * @returns Whether the control currently satisfies its native constraints.
     */
    const validateField = (control: ContactControl): boolean => {
      const error = form.querySelector<HTMLElement>(
        `[data-field-error="${control.name}"]`,
      );
      const valid = control.validity.valid;
      control.setAttribute('aria-invalid', String(!valid));
      if (error) {
        error.textContent = valid
          ? ''
          : (requiredMessages[control.name] ?? '请检查此字段');
      }
      return valid;
    };

    controls.forEach((control) => {
      control.addEventListener('input', () => validateField(control));
      control.addEventListener('change', () => validateField(control));
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const firstInvalid = controls.find((control) => !validateField(control));
      controls.forEach(validateField);
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }
      if (status) {
        status.textContent = '联系渠道尚未配置，请稍后联系。';
        status.dataset.state = 'unconfigured';
      }
    });
  };

  document
    .querySelectorAll<HTMLFormElement>('[data-project-contact-form]')
    .forEach(initializeContactForm);
  document.addEventListener('astro:page-load', () => {
    document
      .querySelectorAll<HTMLFormElement>('[data-project-contact-form]')
      .forEach(initializeContactForm);
  });
</script>
