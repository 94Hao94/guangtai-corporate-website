---
import type { SitePage } from '../../lib/page-schema';

interface Props {
  highlight: NonNullable<SitePage['highlight']>;
}
const { highlight } = Astro.props;
---

<section id="highlight" class="inner-highlight inner-section" data-reveal>
  <div class="inner-heading">
    <p>{highlight.eyebrow}</p><h2>{highlight.title}</h2>
  </div><p class="inner-highlight__intro">{highlight.intro}</p><div
    class="inner-highlight__grid"
  >
    {
      highlight.items.map((item, index) => (
        <article>
          <>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </>
        </article>
      ))
    }
  </div>
  {
    highlight.steps && (
      <ol class="inner-highlight__steps" aria-label="交付路径">
        {highlight.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    )
  }
  {
    highlight.closing && (
      <p class="inner-highlight__closing">{highlight.closing}</p>
    )
  }
</section>
