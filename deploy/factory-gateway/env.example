# Generate the password record without putting the password in command history:
#   read -rs FACTORY_PASSWORD
#   printf '%s' "$FACTORY_PASSWORD" | node scripts/hash-password.mjs
#   unset FACTORY_PASSWORD
FACTORY_ACCESS_PASSWORD_HASH=

# Generate an independent 32-byte session secret:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
FACTORY_SESSION_SECRET=

FACTORY_PUBLIC_ORIGIN=https://www.tjgtkj.cn
FACTORY_GATEWAY_PORT=5180
